{
  "name": "gpovalues",
  "version": "3.0.0",
  "description": "Grand Piece Online (GPO) Trading Values, Tier List, and Trade Calculator Web Application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test tests/*.test.js && python3 -B -m unittest discover -s tests -p 'test_*.py'",
    "test:browser": "node scripts/browser_check.js",
    "build": "python3 -B -m scripts.build_site",
    "prices": "python3 -B -m scripts.update_values",
    "sync": "node sync_tierlist.js",
    "bot": "python3 -B -m scripts.collector_daemon"
  },
  "keywords": [
    "gpo",
    "grand-piece-online",
    "roblox",
    "trading",
    "trade-calculator",
    "tier-list"
  ],
  "author": "GPO Community",
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.1"
  }
}
